# =============================================
# Konfigurasi Aplikasi Toko Online
# Salin file ini menjadi .env dan isi nilainya
# =============================================

# ---- Aplikasi ----
APP_NAME="Online Store Flash Sale API"
APP_ENV=local
APP_URL=http://localhost/onlinestore/public

# ---- Database PostgreSQL ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=onlinestore
DB_USER=postgres
DB_PASS=
